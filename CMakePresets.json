{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "ITLABAI_BUILD_APPS": "ON",
        "ITLABAI_ENABLE_OPENMP": "ON",
        "ITLABAI_ENABLE_KOKKOS": "ON"
      }
    },
    {
      "name": "dev-debug",
      "inherits": "dev",
      "binaryDir": "build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "dev-release",
      "inherits": "dev",
      "binaryDir": "build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "dev-relwithdebinfo",
      "inherits": "dev",
      "binaryDir": "build/relwithdebinfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "asan",
      "inherits": "dev-debug",
      "binaryDir": "build/asan",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address -fno-omit-frame-pointer",
        "CMAKE_C_FLAGS": "-fsanitize=address -fno-omit-frame-pointer"
      }
    },
    {
      "name": "ci",
      "inherits": "dev-release",
      "binaryDir": "build/ci",
      "cacheVariables": {
        "ITLABAI_WERROR": "ON"
      }
    },
    {
      "name": "ci-stats",
      "inherits": "ci",
      "binaryDir": "build/ci-stats",
      "cacheVariables": {
        "ENABLE_STATISTIC_TENSORS": "ON",
        "ENABLE_STATISTIC_TIME": "ON",
        "ENABLE_STATISTIC_WEIGHTS": "ON",
        "ITLABAI_WERROR": "ON"
      }
    },
    {
      "name": "coverage",
      "inherits": "dev-relwithdebinfo",
      "binaryDir": "build/coverage",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "--coverage",
        "CMAKE_C_FLAGS": "--coverage"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug"
    },
    {
      "name": "dev-release",
      "configurePreset": "dev-release"
    },
    {
      "name": "dev-relwithdebinfo",
      "configurePreset": "dev-relwithdebinfo"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "ci",
      "configurePreset": "ci"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    },
    {
      "name": "ci-stats",
      "configurePreset": "ci-stats"
    }
  ],
  "testPresets": [
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev-release",
      "configurePreset": "dev-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev-relwithdebinfo",
      "configurePreset": "dev-relwithdebinfo",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-stats",
      "configurePreset": "ci-stats",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
