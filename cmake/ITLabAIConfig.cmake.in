@PACKAGE_INIT@
include(CMakeFindDependencyMacro)

set(_itlabai_openmp_required FALSE)
if("@ITLABAI_ENABLE_OPENMP@" STREQUAL "ON")
    set(_itlabai_openmp_required TRUE)
    find_dependency(OpenMP)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ITLabAIThirdPartyTargets.cmake")

if(_itlabai_openmp_required AND NOT TARGET OpenMP::OpenMP_CXX)
    set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
    set(_msg "OpenMP support was enabled for this ITLabAI package, but OpenMP::OpenMP_CXX is unavailable")
    if(CMAKE_VERSION VERSION_GREATER_EQUAL "3.17")
        set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE "${_msg}")
    endif()
    if(${CMAKE_FIND_PACKAGE_NAME}_FIND_REQUIRED)
        message(FATAL_ERROR "${_msg}")
    else()
        message(STATUS "${_msg}")
    endif()
    return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ITLabAITargets.cmake")
