@PACKAGE_INIT@

# Bundled third-party targets shipped with ITLabAI.
# This file is included by ITLabAIConfig.cmake.

set(_itlabai_vendor_lib_dir "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/itlabai/thirdparty/lib")
set(_itlabai_vendor_include_dir "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@/itlabai/thirdparty")

if(NOT TARGET TBB::tbb)
  add_library(TBB::tbb SHARED IMPORTED)
  if(WIN32)
    set_target_properties(TBB::tbb PROPERTIES
      IMPORTED_LOCATION "${_itlabai_vendor_lib_dir}/tbb12.dll"
      IMPORTED_IMPLIB "${_itlabai_vendor_lib_dir}/tbb12.lib"
      INTERFACE_INCLUDE_DIRECTORIES "${_itlabai_vendor_include_dir}/tbb"
    )
  elseif(APPLE)
    set_target_properties(TBB::tbb PROPERTIES
      IMPORTED_LOCATION "${_itlabai_vendor_lib_dir}/libtbb.dylib"
      INTERFACE_INCLUDE_DIRECTORIES "${_itlabai_vendor_include_dir}/tbb"
    )
  else()
    set_target_properties(TBB::tbb PROPERTIES
      IMPORTED_LOCATION "${_itlabai_vendor_lib_dir}/libtbb.so"
      INTERFACE_INCLUDE_DIRECTORIES "${_itlabai_vendor_include_dir}/tbb"
    )
  endif()
endif()

# Compatibility shim: the in-tree build wires ITLabAI targets via TBB_unified.
# Keep the same target name in the installed package so consumers get proper
# include dirs and link dependencies without needing system TBB.
if(NOT TARGET TBB_unified)
  add_library(TBB_unified INTERFACE IMPORTED)
  set_property(TARGET TBB_unified PROPERTY INTERFACE_LINK_LIBRARIES TBB::tbb)
endif()

if(NOT TARGET dnnl)
  add_library(dnnl SHARED IMPORTED)
  if(WIN32)
    set_target_properties(dnnl PROPERTIES
      IMPORTED_LOCATION "${_itlabai_vendor_lib_dir}/dnnl.dll"
      IMPORTED_IMPLIB "${_itlabai_vendor_lib_dir}/dnnl.lib"
      INTERFACE_INCLUDE_DIRECTORIES "${_itlabai_vendor_include_dir}/onednn"
    )
  elseif(APPLE)
    set_target_properties(dnnl PROPERTIES
      IMPORTED_LOCATION "${_itlabai_vendor_lib_dir}/libdnnl.dylib"
      INTERFACE_INCLUDE_DIRECTORIES "${_itlabai_vendor_include_dir}/onednn"
    )
  else()
    set_target_properties(dnnl PROPERTIES
      IMPORTED_LOCATION "${_itlabai_vendor_lib_dir}/libdnnl.so"
      INTERFACE_INCLUDE_DIRECTORIES "${_itlabai_vendor_include_dir}/onednn"
    )
  endif()
  if(TARGET TBB::tbb)
    target_link_libraries(dnnl INTERFACE TBB::tbb)
  endif()
endif()

if(NOT TARGET OpenCV::opencv_world)
  add_library(OpenCV::opencv_world SHARED IMPORTED)
  if(WIN32)
    set(_itlabai_opencv_dll "opencv_world@ITLABAI_OPENCV_DLLVERSION@.dll")
    set(_itlabai_opencv_lib "opencv_world@ITLABAI_OPENCV_DLLVERSION@.lib")
    set_target_properties(OpenCV::opencv_world PROPERTIES
      IMPORTED_LOCATION "${_itlabai_vendor_lib_dir}/${_itlabai_opencv_dll}"
      IMPORTED_IMPLIB "${_itlabai_vendor_lib_dir}/${_itlabai_opencv_lib}"
      INTERFACE_INCLUDE_DIRECTORIES "${_itlabai_vendor_include_dir}/opencv"
    )
  elseif(APPLE)
    set_target_properties(OpenCV::opencv_world PROPERTIES
      IMPORTED_LOCATION "${_itlabai_vendor_lib_dir}/libopencv_world.dylib"
      INTERFACE_INCLUDE_DIRECTORIES "${_itlabai_vendor_include_dir}/opencv/opencv4"
    )
  else()
    set_target_properties(OpenCV::opencv_world PROPERTIES
      IMPORTED_LOCATION "${_itlabai_vendor_lib_dir}/libopencv_world.so"
      INTERFACE_INCLUDE_DIRECTORIES "${_itlabai_vendor_include_dir}/opencv/opencv4"
    )
  endif()
endif()

if(NOT TARGET Kokkos_imported)
  add_library(Kokkos_imported INTERFACE IMPORTED)
  if(WIN32)
    set(_itlabai_kokkos_core "${_itlabai_vendor_lib_dir}/kokkoscore.lib")
    set(_itlabai_kokkos_cont "${_itlabai_vendor_lib_dir}/kokkoscontainers.lib")
  else()
    set(_itlabai_kokkos_core "${_itlabai_vendor_lib_dir}/libkokkoscore.a")
    set(_itlabai_kokkos_cont "${_itlabai_vendor_lib_dir}/libkokkoscontainers.a")
  endif()
  if(EXISTS "${_itlabai_kokkos_core}" AND EXISTS "${_itlabai_kokkos_cont}")
    add_library(kokkoscore_external STATIC IMPORTED)
    set_target_properties(kokkoscore_external PROPERTIES
      IMPORTED_LOCATION "${_itlabai_kokkos_core}"
      INTERFACE_INCLUDE_DIRECTORIES "${_itlabai_vendor_include_dir}/kokkos"
    )
    add_library(kokkoscontainers_external STATIC IMPORTED)
    set_target_properties(kokkoscontainers_external PROPERTIES
      IMPORTED_LOCATION "${_itlabai_kokkos_cont}"
      INTERFACE_INCLUDE_DIRECTORIES "${_itlabai_vendor_include_dir}/kokkos"
    )
    target_link_libraries(Kokkos_imported INTERFACE kokkoscore_external kokkoscontainers_external)
  endif()
endif()

if(NOT TARGET nlohmann_json::nlohmann_json)
  add_library(nlohmann_json::nlohmann_json INTERFACE IMPORTED)
  set_target_properties(nlohmann_json::nlohmann_json PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${_itlabai_vendor_include_dir}/json"
  )
endif()
